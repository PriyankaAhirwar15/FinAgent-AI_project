# Groq Cloud API Key (Get at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Supported models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b)
MODEL_NAME=openai/gpt-oss-120b

# Tavily Search API Key (Get at https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# API & Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=https://finagent-api-upgrade.onrender.com

# Environment
ENVIRONMENT=development
DEBUG=True
